# ==========================================
# ClaimCheck - Environment Configuration Example
# ==========================================
# Copy this file to .env and fill in your private API keys:
# cp .env.example .env

# Server port (default 5000)
PORT=5000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB Community Server connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/claimcheck

# Google Gemini API Key (Get free key at: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (Recommended: gemini-3.8-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# SerpApi Key for real-time web evidence (Get key at: https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here
